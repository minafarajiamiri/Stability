# -----------------------------
# Helpers
# -----------------------------
def _standardize_dataset_names(df: pd.DataFrame) -> pd.DataFrame:
    """Normalize dataset labels across files."""
    return df.replace({
        "Radiorag dataset": "Benchmark-RadQA",
        "internal TUM dataset": "Board-RadQA"
    })

def _panel_label(ax, letter: str):
    ax.text(0.0, 1.02, rf"$\mathbf{{{letter}}}$",
            transform=ax.transAxes, ha="left", va="bottom",
            fontsize=12, fontweight="bold")

def _safe_float_from_summary(summary_df: pd.DataFrame, metric_name: str, default=np.nan) -> float:
    """Fetch numeric value from a summary table with columns: Metric, Value."""
    try:
        val = summary_df.loc[summary_df["Metric"] == metric_name, "Value"].values[0]
        return float(val)
    except Exception:
        return float(default)

def _p_to_str(p: float) -> str:
    if np.isnan(p):
        return "P=?"
    if p < 0.001:
        return "P<0.001"
    return f"P={p:.3f}"



def plot_panel_a_schematic(ax):
    """
    Redesigned Panel A: Clean, Nature-style schematic of the metric.
    Flow: Input -> 25x Grid (Evaluation) -> Math (Aggregation).
    Bottom: Visual representation of the bin thresholds.
    """
    ax.set_axis_off()
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1)

    # --- Constants for layout ---
    y_flow = 0.65       # Center line for the top process flow
    y_bins = 0.15       # Center line for the bottom binning strip
    
    # Colors (matching your global palette)
    c_correct = PALETTE_BINS["High"]
    c_incorrect = PALETTE_BINS["Low"]
    c_arrow = "#555555"
    c_text_main = "#222222"
    c_text_sub = "#666666"

    # --- SECTION 1: The Process Flow (Top 70%) ---

    # 1. INPUT (Left)
    # A simple document icon representing the prompt
    doc_x, doc_y = 0.08, y_flow
    doc_w, doc_h = 0.12, 0.16
    rect = FancyBboxPatch((doc_x, doc_y - doc_h/2), doc_w, doc_h,
                          boxstyle="round,pad=0.01,rounding_size=0.02",
                          facecolor="#f0f0f0", edgecolor="#333333", lw=1.0,
                          transform=ax.transAxes, zorder=2)
    ax.add_patch(rect)
    
    # Text: "1 Prompt"
    ax.text(doc_x + doc_w/2, doc_y, "Query", 
            ha="center", va="center", fontsize=8, fontweight="bold", color=c_text_main, transform=ax.transAxes)
    
    # Arrow 1: Input -> Models
    ax.annotate("", xy=(0.32, y_flow), xytext=(0.22, y_flow),
                xycoords=ax.transAxes,
                arrowprops=dict(arrowstyle="-|>", color=c_arrow, lw=1.5, shrinkA=0, shrinkB=0))
    ax.text(0.27, y_flow + 0.05, "x25", ha="center", va="bottom", 
            fontsize=7, color=c_text_sub, transform=ax.transAxes)

    # 2. EVALUATION (Center) - The 5x5 Grid
    grid_cx, grid_cy = 0.45, y_flow
    grid_step = 0.035
    
    # Draw the grid (centered around grid_cx, grid_cy)
    # Let's show a realistic result: e.g., 18 Correct, 7 Incorrect
    n_total = 25
    n_correct = 18
    
    # Calculate start positions to center the 5x5 grid
    start_x = grid_cx - (2 * grid_step)
    start_y = grid_cy - (2 * grid_step)
    
    count = 0
    for i in range(5):      # rows
        for j in range(5):  # cols
            # Determine color (fill bottom-up or simple linear)
            is_cor = count < n_correct
            col = c_correct if is_cor else c_incorrect
            
            # Draw dot
            cx = start_x + j * grid_step
            cy = start_y + (4-i) * grid_step # Fill from top-left visually
            
            circ = Circle((cx, cy), radius=0.012, 
                          facecolor=col, edgecolor="none", alpha=0.9, 
                          transform=ax.transAxes, zorder=3)
            ax.add_patch(circ)
            count += 1
            
    # Label: "25 Outputs"
    ax.text(grid_cx, grid_cy + 0.14, "25 Model\nOutputs", 
            ha="center", va="bottom", fontsize=8, fontweight="bold", 
            color=c_text_main, transform=ax.transAxes, linespacing=1.1)

    # Arrow 2: Models -> Score
    ax.annotate("", xy=(0.70, y_flow), xytext=(0.58, y_flow),
                xycoords=ax.transAxes,
                arrowprops=dict(arrowstyle="-|>", color=c_arrow, lw=1.5, shrinkA=0, shrinkB=0))

    # 3. METRIC (Right)
    # Display the formula and result
    score_x = 0.82
    ax.text(score_x+0.05, y_flow + 0.09, "Robustness Score", 
            ha="center", va="bottom", fontsize=8, fontweight="bold", color=c_text_main, transform=ax.transAxes)
    
    # The Math
    # using LaTeX for nice formatting
    latex_formula = r"$R = \frac{N_{correct}}{25}$"
    ax.text(score_x+0.03, y_flow - 0.01, latex_formula, 
            ha="center", va="center", fontsize=11, color="#000000", transform=ax.transAxes)
    
    # Example value
    # ax.text(score_x, y_flow - 0.12, "(e.g., 0.72)", 
    #         ha="center", va="center", fontsize=7, color=c_text_sub, transform=ax.transAxes)


    # --- SECTION 2: The Interpretation (Bottom 25%) ---
    
    # Label "Binning Thresholds"
    ax.text(0.02, 0.35, "Robustness Bins (Scale)", 
            ha="left", va="bottom", fontsize=8, fontweight="bold", color=c_text_main, transform=ax.transAxes)

    # Draw the continuous bar
    bar_x, bar_y = 0.02, 0.15
    bar_w, bar_h = 0.96, 0.08
    
    # 1. Low (0.0 - 0.4)
    w_low = bar_w * 0.4
    r_low = Rectangle((bar_x, bar_y), w_low, bar_h, 
                      facecolor=PALETTE_BINS["Low"], alpha=0.3, edgecolor="none", transform=ax.transAxes)
    ax.add_patch(r_low)
    ax.text(bar_x + w_low/2, bar_y + bar_h/2, "Low", 
            ha="center", va="center", fontsize=7, color="#800000", fontweight="bold", transform=ax.transAxes)

    # 2. Medium (0.4 - 0.8)
    w_med = bar_w * 0.4
    r_med = Rectangle((bar_x + w_low, bar_y), w_med, bar_h, 
                      facecolor=PALETTE_BINS["Medium"], alpha=0.3, edgecolor="none", transform=ax.transAxes)
    ax.add_patch(r_med)
    ax.text(bar_x + w_low + w_med/2, bar_y + bar_h/2, "Medium", 
            ha="center", va="center", fontsize=7, color="#805500", fontweight="bold", transform=ax.transAxes)

    # 3. High (0.8 - 1.0)
    w_high = bar_w * 0.2
    r_high = Rectangle((bar_x + w_low + w_med, bar_y), w_high, bar_h, 
                       facecolor=PALETTE_BINS["High"], alpha=0.3, edgecolor="none", transform=ax.transAxes)
    ax.add_patch(r_high)
    ax.text(bar_x + w_low + w_med + w_high/2, bar_y + bar_h/2, "High", 
            ha="center", va="center", fontsize=7, color="#004d00", fontweight="bold", transform=ax.transAxes)

    # Threshold Ticks & Labels (0, 0.4, 0.8, 1.0)
    tick_y_top = bar_y + bar_h
    tick_y_bot = bar_y
    
    # Outline box
    ax.add_patch(Rectangle((bar_x, bar_y), bar_w, bar_h, fill=False, edgecolor="#888888", lw=0.5, transform=ax.transAxes))

    # Ticks
    for val in [0.0, 0.4, 0.8, 1.0]:
        x_pos = bar_x + (val * bar_w)
        # Small tick line
        ax.plot([x_pos, x_pos], [tick_y_bot, tick_y_top], color="#666666", lw=0.8, transform=ax.transAxes)
        # Label below
        ax.text(x_pos, bar_y - 0.03, f"{val}", 
                ha="center", va="top", fontsize=7, color=c_text_sub, transform=ax.transAxes)


