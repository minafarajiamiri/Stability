def create_figure_4():
    print("Loading data...")
    scores_radio  = pd.read_csv("robustness_scores_Radiorag_dataset.csv")
    scores_tum    = pd.read_csv("robustness_scores_internal_TUM_dataset.csv")
    trans_radio   = pd.read_csv("robustness_transitions_Radiorag_dataset.csv")
    trans_tum     = pd.read_csv("robustness_transitions_internal_TUM_dataset.csv")
    summary_radio = pd.read_csv("table_3_summary_Radiorag_dataset.csv")
    summary_tum   = pd.read_csv("table_3_summary_internal_TUM_dataset.csv")

    scores_df = pd.concat([scores_radio, scores_tum], ignore_index=True)
    scores_df = _standardize_dataset_names(scores_df)

    # ---- Figure canvas (single-column Nature-ish width; adjust if you use 2-column)
    fig = plt.figure(figsize=(7.4, 6.6))

    # Outer grid: 3 rows x 2 columns
    outer = fig.add_gridspec(
        nrows=3, ncols=2,
        height_ratios=[0.95, 1.05, 1.05],
        width_ratios=[0.95, 1.25],
        left=0.07, right=0.99, top=0.98, bottom=0.08,
        wspace=0.30, hspace=0.48
    )

    # Top row
    ax_a = fig.add_subplot(outer[0, 0])
    ax_b = fig.add_subplot(outer[0, 1])

    # Middle row: panel c spans both columns; split into 3 facets
    c_gs = outer[1, :].subgridspec(1, 3, wspace=0.30)
    ax_c1 = fig.add_subplot(c_gs[0, 0])
    ax_c2 = fig.add_subplot(c_gs[0, 1])
    ax_c3 = fig.add_subplot(c_gs[0, 2])

    # Bottom row: panel d left; panel e right split into 2
    ax_d = fig.add_subplot(outer[2, 0])
    e_gs = outer[2, 1].subgridspec(1, 2, wspace=0.25)
    ax_e1 = fig.add_subplot(e_gs[0, 0])
    ax_e2 = fig.add_subplot(e_gs[0, 1])

    # Draw panels
