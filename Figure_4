def plot_panel_d_bins(ax, scores_df):
    df = scores_df.copy()
    df = _standardize_dataset_names(df)

    datasets = ["Benchmark-RadQA", "Board-RadQA"]
    methods = ["zero-shot", "agentic"]
    bins = ["Low", "Medium", "High"]

    # compute percentages from the data
    perc = {}
    for ds in datasets:
        for m in methods:
            sub = df[(df["dataset"] == ds) & (df["method"] == m)]
            total = len(sub)
            counts = sub["robustness_bin"].value_counts()
            perc[(ds, m)] = {b: (counts.get(b, 0) / total * 100 if total else 0.0) for b in bins}

    centers = np.arange(len(datasets))
    width = 0.36
    x_zs = centers - width/2
    x_ag = centers + width/2

    def _stacked(x, ds, m):
        low = perc[(ds, m)]["Low"]
        med = perc[(ds, m)]["Medium"]
        high = perc[(ds, m)]["High"]

        ax.bar(x, low, width, color=PALETTE_BINS["Low"], edgecolor="white", linewidth=1.0)
        ax.bar(x, med, width, bottom=low, color=PALETTE_BINS["Medium"], edgecolor="white", linewidth=1.0)
        ax.bar(x, high, width, bottom=low+med, color=PALETTE_BINS["High"], edgecolor="white", linewidth=1.0)

        # labels inside segments (only if readable)
        for y0, val, col in [(0, low, "white"), (low, med, "black"), (low+med, high, "white")]:
            if val >= 6:
                ax.text(x, y0 + val/2, f"{val:.0f}",
                        ha="center", va="center", fontsize=7, fontweight="bold", color=col)

    for i, ds in enumerate(datasets):
        _stacked(x_zs[i], ds, "zero-shot")
        _stacked(x_ag[i], ds, "agentic")

    ax.set_ylabel("Proportion (%)")
    ax.set_ylim(0, 100)

    # Major ticks: dataset labels at centers
    ax.set_xticks(centers)
    ax.set_xticklabels(datasets)

    # Minor ticks: ZS/AG under each bar
    bar_positions = np.ravel(np.column_stack([x_zs, x_ag]))
    ax.set_xticks(bar_positions, minor=True)
    ax.set_xticklabels(["ZS", "AG"] * len(datasets), minor=True)

    ax.tick_params(axis="x", which="major", pad=14, length=0)
    ax.tick_params(axis="x", which="minor", pad=2, length=0)

    # --- FIX: Move legend above the plot ---
    # We use bbox_to_anchor to place it just above the top axis line
    handles = [mpatches.Patch(color=PALETTE_BINS[b], label=b) for b in ["High", "Medium", "Low"]]
    ax.legend(handles=handles, 
              loc="lower center",           # Anchor point on the legend box
              bbox_to_anchor=(0.5, 0.97),   # Place it above the axes (x=0.5, y=1.02)
              ncol=3,                       # Horizontal layout
              fontsize=8, 
              frameon=False,
              handlelength=1.0, 
              handletextpad=0.4,
              columnspacing=1.0)

    ax.set_axisbelow(True)

