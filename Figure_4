# PALETTE_METHODS  = {"zero-shot": "#ff7f0e", "agentic": "#d62728"}
PALETTE_METHODS  = {"zero-shot": "tab:blue", "agentic": "tab:green"}
PALETTE_BINS     = {"High": "#2ca02c", "Medium": "#ffbb33", "Low": "#d62728"}
