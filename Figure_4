# PANEL E: Alluvial / Sankey-style bin transitions (split into two subpanels)
# ============================================================================
def _draw_alluvial_one(ax, trans_df, title):
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1)
    ax.axis("off")

    # Visual order top-to-bottom
    bins_visual = ["High", "Medium", "Low"]
    y = {"High": 0.78, "Medium": 0.50, "Low": 0.22}
    h = 0.16

    # Rank for "improved" vs "decreased"
    rank = {"Low": 0, "Medium": 1, "High": 2}

    left_x, right_x = 0.10, 0.72
    box_w = 0.16

    # Counts
    left_counts = {b: int((trans_df["zero_shot_bin"] == b).sum()) for b in bins_visual}
    right_counts = {b: int((trans_df["agentic_bin"] == b).sum()) for b in bins_visual}

    # Bin boxes
    for b in bins_visual:
        ax.add_patch(FancyBboxPatch((left_x, y[b]-h/2), box_w, h,
                                    boxstyle="round,pad=0.01",
                                    facecolor=PALETTE_BINS[b], edgecolor="black", lw=0.8, alpha=0.75))
        ax.text(left_x + box_w/2, y[b], f"{left_counts[b]}",
                ha="center", va="center", fontsize=8, fontweight="bold", color="white")

        ax.add_patch(FancyBboxPatch((right_x, y[b]-h/2), box_w, h,
                                    boxstyle="round,pad=0.01",
                                    facecolor=PALETTE_BINS[b], edgecolor="black", lw=0.8, alpha=0.75))
        ax.text(right_x + box_w/2, y[b], f"{right_counts[b]}",
                ha="center", va="center", fontsize=8, fontweight="bold", color="white")

    # Flow scaling
    flow_counts = []
    for fb in ["Low", "Medium", "High"]:
        for tb in ["Low", "Medium", "High"]:
            c = int(((trans_df["zero_shot_bin"] == fb) & (trans_df["agentic_bin"] == tb)).sum())
            if c > 0:
                flow_counts.append(c)
    max_c = max(flow_counts) if flow_counts else 1

    # Draw flows
    for fb in ["Low", "Medium", "High"]:
        for tb in ["Low", "Medium", "High"]:
            c = int(((trans_df["zero_shot_bin"] == fb) & (trans_df["agentic_bin"] == tb)).sum())
            if c == 0:
                continue

            if fb == tb:
                col, a = PALETTE_TRANS["No Change"], 0.22
            elif rank[tb] > rank[fb]:
                col, a = PALETTE_TRANS["Improved"], 0.45
            else:
                col, a = PALETTE_TRANS["Decreased"], 0.60

            lw = 1.0 + 6.0 * (c / max_c)  # stable, readable

            ax.add_patch(FancyArrowPatch(
                (left_x + box_w, y[fb]), (right_x, y[tb]),
                connectionstyle="arc3,rad=0.25",
                arrowstyle="-",
                lw=lw, color=col, alpha=a, zorder=0
            ))

    # Titles and labels
    ax.text(left_x + box_w/2, 0.95, "Zero-shot", ha="center", va="top",
            fontsize=9, fontweight="bold")
    ax.text(right_x + box_w/2, 0.95, "Agentic", ha="center", va="top",
            fontsize=9, fontweight="bold")
    ax.text(0.5, 0.02, title, ha="center", va="bottom",
            fontsize=9, fontweight="bold")

def plot_panel_e_transitions_split(ax_left, ax_right, trans_radio, trans_tum):
    # Ensure expected columns exist
    needed = {"zero_shot_bin", "agentic_bin"}
    if not needed.issubset(set(trans_radio.columns)) or not needed.issubset(set(trans_tum.columns)):
        raise ValueError("Transition CSVs must include columns: zero_shot_bin, agentic_bin")

    _draw_alluvial_one(ax_left, trans_radio, "Benchmark-RadQA")
    _draw_alluvial_one(ax_right, trans_tum, "Board-RadQA")


