def plot_panel_b_scatter(ax, scores_df):
    df = scores_df.copy()
    df = _standardize_dataset_names(df)

    zs = df[df["method"] == "zero-shot"][["dataset", "question_id", "robustness_score"]].rename(
        columns={"robustness_score": "rob_zs"}
    )
    ag = df[df["method"] == "agentic"][["dataset", "question_id", "robustness_score"]].rename(
        columns={"robustness_score": "rob_ag"}
    )
    merged = pd.merge(zs, ag, on=["dataset", "question_id"], how="inner")

    # Background shading (improved vs decreased regions)
    x = np.linspace(0, 1, 200)
    ax.fill_between(x, 0, x, color=PALETTE_TRANS["Improved"], alpha=0.08, zorder=0, linewidth=0)
    ax.fill_between(x, x, 1, color=PALETTE_TRANS["Decreased"], alpha=0.08, zorder=0, linewidth=0)

    # Identity line
    ax.plot([0, 1], [0, 1], color="black", lw=1.0, alpha=0.5, zorder=1)

    # Scatter by dataset
    specs = [
        ("Benchmark-RadQA", PALETTE_DATASETS["Benchmark-RadQA"], "o"),
        ("Board-RadQA",     PALETTE_DATASETS["Board-RadQA"],     "^"),
    ]
    for ds, col, mk in specs:
        sub = merged[merged["dataset"] == ds]
        ax.scatter(sub["rob_zs"], sub["rob_ag"],
                   s=22, marker=mk, c=col, alpha=0.65,
                   edgecolors="black", linewidths=0.4,
                   label=ds, zorder=2)

    ax.set_xlabel("Robustness score (zero-shot)")
    ax.set_ylabel("Robustness score (agentic)")
    ax.set_xlim(-0.02, 1.02)
    ax.set_ylim(-0.02, 1.02)

    ax.text(0.76, 0.18, "Improved", color=PALETTE_TRANS["Improved"],
            fontsize=8, fontweight="bold", ha="center", va="center")
    ax.text(0.20, 0.55, "Decreased", color=PALETTE_TRANS["Decreased"],
            fontsize=8, fontweight="bold", ha="center", va="center")

    ax.set_axisbelow(True)
    ax.legend(loc="upper left")


