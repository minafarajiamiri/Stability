def plot_panel_c_distributions(axes, scores_df, summary_radio, summary_tum):
    df = scores_df.copy()
    df = _standardize_dataset_names(df)

    groups = [
        ("Pooled",          df, None),
        ("Benchmark-RadQA", df[df["dataset"] == "Benchmark-RadQA"], summary_radio),
        ("Board-RadQA",     df[df["dataset"] == "Board-RadQA"],     summary_tum),
    ]

    rng = np.random.default_rng(42)

    for ax, (title, subdf, summ) in zip(axes, groups):
        zs = subdf[subdf["method"] == "zero-shot"]["robustness_score"].to_numpy()
        ag = subdf[subdf["method"] == "agentic"]["robustness_score"].to_numpy()

        plot_data = [zs, ag]
        positions = [1, 2]
        colors = [PALETTE_METHODS["zero-shot"], PALETTE_METHODS["agentic"]]
        colors_points = {"tab:orange", "tab:red"}
        # Violin
        vp = ax.violinplot(plot_data, positions=positions, widths=0.75,
                           showmeans=False, showmedians=False, showextrema=False)
        for body, col in zip(vp["bodies"], colors):
            body.set_facecolor(col)
            body.set_alpha(0.22)
            body.set_edgecolor("none")

        # Box
        ax.boxplot(plot_data, positions=positions, widths=0.25, showfliers=False,
                   patch_artist=True,
                   boxprops=dict(facecolor="none", linewidth=1.0),
                   whiskerprops=dict(linewidth=1.0),
                   capprops=dict(linewidth=1.0),
                   medianprops=dict(color="black", linewidth=1.3))

        # Swarm-ish jitter
        for pos, vals, col in zip(positions, plot_data, colors_points):
            if len(vals) == 0:
                continue
            jitter = rng.normal(0, 0.05, size=len(vals))
            ax.scatter(np.full(len(vals), pos) + jitter, vals,
                       s=7, alpha=0.35, c=col, edgecolors="none", zorder=2)

        ax.set_xticks([1, 2])
        ax.set_xticklabels(["Zero-shot", "Agentic"])
        ax.set_ylim(-0.05, 1.05)
        ax.set_title(title, fontsize=9, fontweight="bold", pad=6)

        # Only left facet shows y-label (cleaner)
        if title == "Pooled":
            ax.set_ylabel("Robustness score")
        else:
            ax.set_ylabel("")

        # Stats annotation (from your Table 3 / Table 2 summary files)
        if summ is not None:
            mean_delta = _safe_float_from_summary(summ, "Mean Δrobustness")
            p_val      = _safe_float_from_summary(summ, "Wilcoxon p-value")
            eff_r      = _safe_float_from_summary(summ, "Effect size (r)")

            stat = f"ΔR̄={mean_delta:.3f}\n{_p_to_str(p_val)}\nr={eff_r:.2f}"
            # ax.text(0.98, 0.98, stat, transform=ax.transAxes,
            #         ha="right", va="top", fontsize=7,
            #         bbox=dict(boxstyle="round,pad=0.25",
            #                   facecolor="white", edgecolor="gray", alpha=0.85))

        ax.set_axisbelow(True)

